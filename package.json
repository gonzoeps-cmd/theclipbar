{
  "name": "theclipbar",
  "version": "0.2.0",
  "private": true,
  "description": "Paste a YouTube or Twitch channel handle, browse recent videos/streams, and generate highlight clips.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "dev": "node --watch src/server.js",
    "postinstall": "node scripts/fetch-ytdlp.js"
  },
  "dependencies": {
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1"
  },
  "engines": {
    "node": ">=18"
  }
}
